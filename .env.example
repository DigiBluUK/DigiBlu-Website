# Copy to .env.local for local work; set the same variables in the Cloudflare
# project's build settings for production. NEXT_PUBLIC_ variables are inlined
# into the client bundle at build time, so a change needs a rebuild.

# Google Analytics 4 measurement id (Admin > Data streams > Web). A
# measurement id is visible to every visitor by design; it is kept out of
# the source so production and previews can use different properties, or
# previews none at all. Leave empty to build with no analytics: the consent
# banner then offers no Analytics category and loads nothing from Google.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# The public origin, used for canonical URLs, share cards, sitemap and robots.
# SITE_ORIGIN=https://digiblu.com
